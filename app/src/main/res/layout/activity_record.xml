<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/VoiceText.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
        app:title="@string/record"
        app:titleTextColor="@color/white" />

    <!-- Waveform visualization area -->
    <LinearLayout
        android:id="@+id/waveform_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/caption_panel"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <!-- Recording indicator -->
        <LinearLayout
            android:id="@+id/recording_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/recording_indicator" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recording"
                android:textColor="@color/recording_red"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Microphone icon -->
        <ImageView
            android:id="@+id/iv_microphone"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/ghibli_button_primary"
            android:padding="24dp"
            android:src="@android:drawable/ic_btn_speak_now"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/tap_to_speak"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <!-- Timer -->
        <Chronometer
            android:id="@+id/chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:format="00:%s"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Live caption panel -->
    <LinearLayout
        android:id="@+id/caption_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E63E3A35"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/controls_container">

        <!-- Zoom controls row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_zoom_out"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/zoom_out"
                android:focusable="true"
                android:gravity="center"
                android:text="A-"
                android:textColor="@color/accent_light"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_zoom_in"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/zoom_in"
                android:focusable="true"
                android:gravity="center"
                android:text="A+"
                android:textColor="@color/accent_light"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Original text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/original_text"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="50dp">

            <TextView
                android:id="@+id/tv_live_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textIsSelectable="true" />

        </ScrollView>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/gray" />

        <!-- Translated text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/translated_text"
            android:textColor="@color/accent_light"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="50dp">

            <TextView
                android:id="@+id/tv_live_translation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="#E8A87C"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textIsSelectable="true" />

        </ScrollView>

    </LinearLayout>

    <!-- Controls -->
    <LinearLayout
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Import button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_import"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:src="@android:drawable/ic_menu_upload"
            android:contentDescription="@string/import_audio"
            app:backgroundTint="@color/gray_dark"
            app:fabSize="mini"
            app:tint="@color/white" />

        <!-- Record button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="@string/record"
            app:backgroundTint="@color/recording_red"
            app:fabSize="normal"
            app:tint="@color/white" />

        <!-- Language button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_language"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="@string/select_language"
            app:backgroundTint="@color/primary"
            app:fabSize="mini"
            app:tint="@color/white" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
